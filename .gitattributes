# Normalize line endings: treat all text as LF in the repo.
* text=auto eol=lf

# Explicit text types
*.py    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
Kconfig text eol=lf

# Binary assets (never normalize)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.bin   binary
*.pdf   binary
*.zip   binary
*.tflite binary
